# Containerfile template for AstralEmu ublue builds
# Generated by build/generate-containerfile.sh
# 
# This template produces a multi-stage build similar to personal-server:
# - base-common stage: base packages + repo setup
# - service-<name> stages: one per service, chained in dependency order
# - final stage: combines everything + validates

# =============================================================================
# BASE IMAGE
# =============================================================================
FROM __BASE_IMAGE_URL__ AS base-common

# Copy devices.yml for repo setup
COPY setupfiles/devices.yml /etc/setupfiles/devices.yml

# Copy all service packages.yml files for repo introspection
__COPY_PACKAGES_YML__

# Setup repositories BEFORE any package installation
# This ensures rpm-ostree can find all packages
RUN <<'EOF'
set -e
export DEVICE_ID="__DEVICE_ID__"
export DISTRO_ID="__DISTRO_ID__"

echo "Configuring repositories for $DEVICE_ID/$DISTRO_ID..."

# Parse devices.yml and configure repos
if [ -f /etc/setupfiles/devices.yml ]; then
    # Get repo count
    REPO_COUNT=$(yq -r ".devices[] | select(.id == \"$DEVICE_ID\") | .distros[] | select(.id == \"$DISTRO_ID\") | .repos | length" /etc/setupfiles/devices.yml 2>/dev/null || echo "0")
    
    if [[ "$REPO_COUNT" -gt 0 ]]; then
        for i in $(seq 0 $((REPO_COUNT - 1))); do
            REPO_NAME=$(yq -r ".devices[] | select(.id == \"$DEVICE_ID\") | .distros[] | select(.id == \"$DISTRO_ID\") | .repos[$i].name" /etc/setupfiles/devices.yml)
            REPO_URL=$(yq -r ".devices[] | select(.id == \"$DEVICE_ID\") | .distros[] | select(.id == \"$DISTRO_ID\") | .repos[$i].url" /etc/setupfiles/devices.yml)
            
            echo "  Adding repo: $REPO_NAME ($REPO_URL)"
            
            # Handle .repo URLs (pre-made repo config)
            if [[ "$REPO_URL" == *.repo ]]; then
                curl -fsSL "$REPO_URL" -o "/etc/yum.repos.d/astralemu-${REPO_NAME}.repo"
            else
                # Generate .repo file from URL
                cat > "/etc/yum.repos.d/astralemu-${REPO_NAME}.repo" << REPOEOF
[astralemu-${REPO_NAME}]
name=AstralEmu - ${REPO_NAME}
baseurl=${REPO_URL}
enabled=1
gpgcheck=0
REPOEOF
            fi
        done
    fi
fi

# Refresh metadata
rpm-ostree refresh-md || true
echo "Repositories configured successfully"
EOF

# Install base packages
RUN rpm-ostree install -y __BASE_PACKAGES__

# =============================================================================
# SERVICE STAGES
# Each service is its own stage, chained in dependency order.
# This provides granular caching: changing service-X only rebuilds X and dependents.
# =============================================================================

__SERVICE_STAGES__

# =============================================================================
# FINAL STAGE
# Inherits from the last service stage (all packages accumulated)
# =============================================================================
FROM __FINAL_PARENT__ AS final

# Copy first-boot scripts (for runtime configuration)
COPY setupfiles/ /etc/setupfiles/

# Run first-boot configuration (optional, runs at build time for now)
# In the future, this could be deferred to actual first boot
# RUN /etc/setupfiles/services-first-boot.sh || true

# Validate bootc image
RUN bootc container lint || true

# Label the image
LABEL org.astralemu.device="__DEVICE_ID__"
LABEL org.astralemu.distro="__DISTRO_ID__"
LABEL org.astralemu.services="__SERVICE_LIST__"
LABEL org.opencontainers.image.title="AstralEmu __DEVICE_ID__"
LABEL org.opencontainers.image.description="AstralEmu image for __DEVICE_ID__ (__DISTRO_ID__)"
